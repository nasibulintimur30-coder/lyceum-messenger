[Unit]
Description=Lyceum Messenger (Node.js + Socket.IO)
After=network.target

[Service]
Type=simple
User=lyceum
WorkingDirectory=/opt/lyceum
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
EnvironmentFile=/opt/lyceum/.env
ExecStart=/usr/bin/node server/src/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
