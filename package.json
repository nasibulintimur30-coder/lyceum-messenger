{
  "name": "lyceum-messenger",
  "version": "1.0.0",
  "private": true,
  "description": "Lyceum Messenger — PWA-мессенджер с обменом сообщениями в реальном времени",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/src/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/src/index.js",
    "postinstall": "npm --prefix server install && node tools/sync-client.mjs",
    "build": "node tools/make-icons.mjs && node tools/sync-client.mjs",
    "icons": "node tools/make-icons.mjs",
    "sync-client": "node tools/sync-client.mjs",
    "test": "npm --prefix server test",
    "test:ui": "npm --prefix server run test:ui",
    "test:cross": "npm --prefix server run test:cross",
    "deploy": "npm run build && netlify deploy --dir web --prod",
    "deploy:init": "netlify init --dir web",
    "deploy:link": "netlify link --dir web"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
